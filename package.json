{
  "name": "pix",
  "version": "0.0.23",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "description": "Graph-first web workbench for Pi Agent",
  "main": "out/web/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "fixtures": "node scripts/install-fixtures.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "install:server:wsl": "node scripts/install-wsl-server.mjs",
    "test:wsl": "node scripts/install-wsl-server.mjs && node scripts/clean-test-out.mjs && tsc -p tsconfig.test.json && node test/wsl-server-test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.app.json",
    "build": "npm run build:server && tsc -p tsconfig.node.json && vite build",
    "test": "node scripts/clean-test-out.mjs && tsc -p tsconfig.test.json && node --test out-test/test/*.test.js && npm run test:renderer && npm run test:terminal",
    "test:renderer": "vitest run --config vitest.config.ts",
    "test:terminal": "node test/node-pty-test.mjs",
    "test:pi": "node test/pi-session-test.mjs",
    "test:fff": "node test/builtin-fff-smoke-test.mjs",
    "test:web": "node --test test/prune-dev-artifacts.test.mjs && node test/web-extension-smoke-test.mjs",
    "verify": "npm run typecheck && npm test && npm run test:pi",
    "dev": "tsc -p tsconfig.node.json && node out/web/index.js --dev",
    "start": "node out/web/index.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-server": "0.87.0",
    "@lucide/vue": "^1.39.0",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.1.0-beta.304",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "8.0.4",
    "fuzzysort": "^4.0.2",
    "katex": "^0.18.7",
    "markstream-vue": "^2.0.6",
    "node-pty": "^1.2.0-beta.15",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "ws": "8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@ff-labs/pi-fff": "0.10.6",
    "@injaneity/pi-computer-use": "0.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "node-pty@1.2.0-beta.15": true
  }
}
