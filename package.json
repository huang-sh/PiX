{
  "name": "pix",
  "version": "0.0.28",
  "private": true,
  "license": "MPL-2.0",
  "desktopName": "pix",
  "type": "module",
  "description": "Graph-first Electron workbench for Pi Agent",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "fixtures": "node scripts/install-fixtures.mjs",
    "build:server": "tsc -p tsconfig.server.json && node scripts/build-cli-assets.mjs",
    "install:server:wsl": "node scripts/install-wsl-server.mjs",
    "test:wsl": "node scripts/install-wsl-server.mjs && node scripts/clean-test-out.mjs && tsc -p tsconfig.test.json && node test/wsl-server-test.mjs",
    "test:wsl:upgrade": "npm run build:server && node test/wsl-upgrade-test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.app.json",
    "build": "npm run build:server && electron-vite build",
    "test": "node scripts/clean-test-out.mjs && tsc -p tsconfig.test.json && node --test out-test/test/*.test.js && npm run test:renderer && npm run test:terminal && npm run test:installation",
    "test:renderer": "vitest run --config vitest.config.ts",
    "test:terminal": "node test/electron-pty-test.mjs",
    "test:pi": "node test/pi-session-test.mjs",
    "test:gui": "npm run build && node test/gui-test.mjs",
    "test:gui:navigator": "npm run build && node test/navigator-gui-test.mjs",
    "test:gui:changes": "node scripts/clean-test-out.mjs && tsc -p tsconfig.test.json && npm run build && node test/file-changes-gui-test.mjs",
    "test:gui:slash": "npm run build && node test/slash-gui-test.mjs",
    "test:gui:toast": "npm run build && node test/gui-toast-test.mjs",
    "test:gui:links": "npm run build && node test/gui-link-test.mjs",
    "test:gui:terminal": "npm run build && node test/terminal-gui-test.mjs",
    "test:gui:typography": "npm run build && node test/typography-gui-test.mjs",
    "test:gui:stop": "npm run build && node test/gui-stop-button-check.mjs",
    "test:gui:chat-switch": "npm run build && node test/gui-session-chat-switch.mjs",
    "test:gui:wsl": "node scripts/install-wsl-server.mjs && npm run build && node test/gui-test.mjs --wsl",
    "test:gui:ssh": "npm run build && node test/gui-test.mjs --ssh",
    "verify": "npm run typecheck && npm test && npm run test:pi && npm run test:gui",
    "dist": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:packaged": "node test/packaged-smoke-test.mjs",
    "test:fff": "node test/builtin-fff-smoke-test.mjs",
    "test:web": "node --test test/prune-dev-artifacts.test.mjs && node test/web-extension-smoke-test.mjs",
    "dev": "npm run build:server && electron-vite dev -w",
    "postinstall": "node node_modules/electron/install.js",
    "build:cli": "npm run build:server",
    "cli": "node bin/pix.mjs",
    "test:cli": "npm run build && node test/cli-host-test.mjs",
    "test:cli:real": "npm run build:cli && node test/cli-real-agent-test.mjs",
    "test:cli:package": "npm run build:cli && node test/cli-package-test.mjs",
    "test:installation": "node --test test/packaged-cli-test.mjs test/windows-cli-path.test.mjs test/prune-dev-artifacts.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@lucide/vue": "^1.39.0",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.1.0-beta.304",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "8.0.4",
    "fuzzysort": "^4.0.2",
    "katex": "^0.18.7",
    "markstream-vue": "^2.0.6",
    "node-pty": "^1.2.0-beta.15",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "undici": "8.10.2",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "ws": "8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@ff-labs/pi-fff": "0.10.6",
    "@injaneity/pi-computer-use": "0.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "electron@44.4.4": true,
    "node-pty@1.2.0-beta.15": true
  },
  "bin": {
    "pix": "bin/pix.mjs"
  }
}
