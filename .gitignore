# Dependencies (matches at any depth, incl. server/node_modules)
node_modules/

# Build output
out/
out-test/
server/dist/
release/
/.pix-installed-*/
/PiX-Setup-*.exe

# Test artifacts (screenshots, logs, reports)
artifacts/

# Pi agent session data (test/workspace/.pi/settings.json is a tracked fixture)
/.pi/
test/workspace/.pi/sessions/

# Workspace fixture dirt: install-fixtures.mjs intentionally leaves
# src/example.ts modified and src/new-file.ts untracked in the nested repo.
# example.ts is script-generated for the same reason (gitignore cannot hide
# changes to a tracked file).
test/workspace/src/example.ts
test/workspace/src/new-file.ts

# Logs
*.log

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
.zcode/
